#!/bin/bash
# =====================================================
# MariaDB Backup Script — managed by Ansible
# Scheduled via cron: {{ backup_cron_minute }} {{ backup_cron_hour }} * * *
# =====================================================

BACKUP_DIR="{{ backup_dir }}"
APP_DIR="{{ app_dir }}"
LOG_FILE="${APP_DIR}/backup.log"
DB_NAME="{{ db_name }}"
DB_USER="{{ db_user }}"
DB_PASSWORD="{{ vault_db_password }}"
RETENTION_DAYS={{ backup_retention_days }}

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

if [ ! -d "$BACKUP_DIR" ]; then
    log_message "ERROR: Backup directory $BACKUP_DIR not found."
    exit 1
fi

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/notes_backup_${TIMESTAMP}.sql"

log_message "Starting backup for database: $DB_NAME"
mysqldump -u "$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" > "$BACKUP_FILE" 2>> "$LOG_FILE"

if [ $? -eq 0 ]; then
    gzip "$BACKUP_FILE"
    log_message "Backup complete: ${BACKUP_FILE}.gz"
    find "$BACKUP_DIR" -name "notes_backup_*.sql.gz" -mtime +"$RETENTION_DAYS" -delete
    log_message "Cleaned up backups older than $RETENTION_DAYS days."
else
    log_message "ERROR: Backup failed."
    rm -f "$BACKUP_FILE"
    exit 1
fi
