# Flask
FLASK_DEBUG={{ flask_debug }}
SECRET_KEY={{ vault_secret_key }}

# Database
DB_HOST={{ db_host }}
DB_USER={{ db_user }}
DB_PASSWORD={{ vault_db_password }}
DB_NAME={{ db_name }}
DB_PORT={{ db_port }}

# Server
PORT={{ app_port }}

# AWS Cognito (optional)
AWS_REGION={{ vault_aws_region }}
COGNITO_USER_POOL_ID={{ vault_cognito_user_pool_id }}
COGNITO_CLIENT_ID={{ vault_cognito_client_id }}
COGNITO_CLIENT_SECRET={{ vault_cognito_client_secret }}
COGNITO_DOMAIN={{ vault_cognito_domain }}

# AWS S3 (optional)
S3_BUCKET_NAME={{ vault_s3_bucket_name }}
